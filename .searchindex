│   │   ├── nq.html                # 新生常见问题
│   │   ├── xiaoli.html            # 清华校历
│   │   ├── time.html              # 上课时间
│   │   ├── thugpa.html            # 清华GPA
│   │   ├── tice.html              # 体测
│   │   ├── xuanke.html            # 选课
│   │   ├── junxun.html            # 军训
│   │   └── ...                    # 更多专题
│   ├── 校内生活设施/               # 生活设施目录
│   │   ├── chaoshi.html           # 超市
│   │   ├── dayin.html             # 打印店
│   │   └── ...                    # 更多设施
│   ├── 老乡在清华/                 # 老乡专区
│   └── 其他/                      # 其他
├── /thucourse/                    # 选课社区首页
│   ├── courses.html               # 所有课程
│   ├── course.html                # 课程详情
│   ├── search.html                # 搜索
│   ├── statistics.html            # 数据统计
│   ├── about.html                 # 关于
│   ├── faq.html                   # 常见问题
│   └── new-review.html            # 新建点评
├── /sitemap.xml                   # 站点地图
├── /sitemap-index.xml             # 站点地图索引
├── /robots.txt                    # 爬虫协议
└── /manifest.json                 # PWA 配置
```

## Update Frequency
- 首页：每周更新
- Thubook/Thucourse 主页：每月更新
- 课程详情页：每周更新
- Thubook 专题页面：每月更新

## Crawler Instructions
- 允许抓取所有公开页面
- 不限制抓取频率
- 禁止抓取私有目录（/_headers、/_redirects、/.git/、/.qwen/）
